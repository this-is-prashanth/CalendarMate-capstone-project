    {
      "parameters": {
        "method": "POST",
        "url": "https://cloud.langfuse.com/api/public/otel/v1/traces",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "langfuseApi",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-langfuse-ingestion-version",
              "value": "4"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify((() => {\n  const s = $('Start trace').first().json;\n  const userId = s.user_id ? String(s.user_id) : null;\n  const results = $('Collect results').all().map(i => i.json);\n  const done = results.filter(r => r.status === 'done').length;\n  const failed = results.filter(r => r.status === 'failed').length;\n  const status = failed === 0 ? 'ok' : (done > 0 ? 'partial' : 'failed');\n  const input = { user_id: s.user_id, proposal_ids: s.proposal_ids };\n  const startNs = String(DateTime.fromISO(s.trace_start).toMillis()) + '000000';\n  const endNs = String($now.toMillis()) + '000000';\n  const str = (k, v) => ({ key: k, value: { stringValue: String(v == null ? '' : v) } });\n  const attrs = [\n    str('langfuse.trace.name', 'cm-email-execute'),\n    str('langfuse.observation.type', 'agent'),\n    str('langfuse.observation.input', JSON.stringify(input)),\n    str('langfuse.observation.output', JSON.stringify(results)),\n    str('langfuse.observation.level', status === 'ok' ? 'DEFAULT' : (status === 'partial' ? 'WARNING' : 'ERROR')),\n    str('langfuse.observation.status_message', results.map(r => r.notes || '').filter(Boolean).join(' | ').slice(0, 1000)),\n    { key: 'langfuse.trace.tags', value: { arrayValue: { values: [{ stringValue: 'n8n' }, { stringValue: 'cm-email-execute' }] } } },\n    str('langfuse.trace.metadata.workflow_id', $workflow.id),\n    str('langfuse.trace.metadata.workflow_name', $workflow.name),\n    str('langfuse.trace.metadata.execution_id', $execution.id),\n    str('langfuse.trace.metadata.mode', $execution.mode),\n    str('langfuse.trace.metadata.status', status),\n    str('langfuse.trace.metadata.sent_count', done),\n    str('langfuse.trace.metadata.failed_count', failed)\n  ];\n  if (userId) attrs.push(str('langfuse.user.id', userId));\n  return { resourceSpans: [{\n    resource: { attributes: [str('service.name', 'n8n')] },\n    scopeSpans: [{ scope: { name: 'n8n-cm-email-execute' }, spans: [{\n      traceId: s.trace_id, spanId: s.span_id, name: 'Email agent (execute)', kind: 1,\n      startTimeUnixNano: startNs, endTimeUnixNano: endNs,\n      attributes: attrs,\n      status: { code: status === 'ok' ? 1 : 2 }\n    }] }]\n  }] };\n})()) }}",
        "options": {
          "timeout": 10000
        }
      },
