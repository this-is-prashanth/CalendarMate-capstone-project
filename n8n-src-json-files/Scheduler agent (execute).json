    {
      "parameters": {
        "jsCode": "// Keep only this user's pending scheduler rows whose ids were approved.\n// The stored action is used as-is; nothing here re-writes it.\nconst input = $('When approved').first().json;\nconst user_id = String(input.user_id || '');\nlet ids = input.proposal_ids;\nif (typeof ids === 'string') { try { ids = JSON.parse(ids); } catch (e) { ids = ids.split(','); } }\nif (!Array.isArray(ids)) ids = ids ? [ids] : [];\nids = ids.map(s => String(s).trim()).filter(Boolean);\nconst rows = $input.all().map(i => i.json)\n  .filter(r => r.proposal_id && String(r.user_id) === user_id && r.status === 'pending' && ids.includes(r.proposal_id));\nconst out = [];\nconst bad = [];\nfor (const r of rows) {\n  let act;\n  try { act = JSON.parse(r.action); } catch (e) { bad.push(r.proposal_id); continue; }\n  // An approved time option (propose_times) means: book that slot.\n  // With an existing event_id it is a move; otherwise it is a new meeting.\n  if (['propose_times', 'propose_time', 'book_slot'].includes(act.type) && act.start && act.end) {\n    act.type = act.event_id ? 'reschedule_event' : 'create_event';\n  }\n  // Weekend rule: never book or move a meeting onto Saturday or Sunday (user's timezone).\n  if ((act.type === 'create_event' || act.type === 'reschedule_event') && act.start) {\n    const st = DateTime.fromISO(String(act.start), { setZone: true }).setZone('Asia/Kolkata');\n    if (st.isValid && st.weekday >= 6) {\n      out.push({ json: { proposal_id: r.proposal_id, user_id: r.user_id, type: 'weekend', summary: r.summary, act,\n        reason: 'Weekend: ' + st.toFormat('cccc d LLL, h:mm a') + ' falls on a ' + st.toFormat('cccc') + '. Meetings are not scheduled on Saturday or Sunday. Nothing was written; the proposal stays pending.' } });\n      continue;\n    }\n  }\n  out.push({ json: { proposal_id: r.proposal_id, user_id: r.user_id, type: act.type, summary: r.summary, act } });\n}\nif (!out.length) {\n  return [{ json: { type: 'none', proposal_id: ids.join(','),\n    reason: bad.length ? 'Stored actions could not be read: ' + bad.join(', ') : 'No pending scheduler proposals match these ids for this user' } }];\n}\nreturn out;"
      },
