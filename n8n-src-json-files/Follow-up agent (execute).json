            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ (() => { const hex = (n) => Array.from({ length: n }, () => Math.floor(Math.random() * 16).toString(16)).join(\"\"); const items = $input.all().map(i => i.json); const input = $('When approved').first().json; const nowMs = Date.now(); const start = String(nowMs) + \"000000\"; const end = String(nowMs + 1) + \"000000\"; const str = (k, v) => ({ key: k, value: { stringValue: String(v) } }); const traceId = hex(32); const rootId = hex(16); const attrs = [str(\"langfuse.trace.name\", $workflow.name), str(\"langfuse.user.id\", input.user_id || \"\"), str(\"langfuse.trace.input\", JSON.stringify({ proposal_ids: input.proposal_ids })), str(\"langfuse.trace.output\", JSON.stringify(items.map(r => ({ proposal_id: r.proposal_id, type: r.type, summary: r.summary })))), { key: \"langfuse.trace.tags\", value: { arrayValue: { values: [{ stringValue: \"n8n\" }, { stringValue: \"follow-up-agent\" }] } } }, str(\"n8n.execution.id\", $execution.id), str(\"n8n.workflow.id\", $workflow.id), str(\"n8n.execution.mode\", $execution.mode)]; const spans = [{ traceId, spanId: rootId, name: $workflow.name, kind: 1, startTimeUnixNano: start, endTimeUnixNano: end, attributes: attrs, status: { code: 1 } }]; items.forEach(r => spans.push({ traceId, spanId: hex(16), parentSpanId: rootId, name: String(r.type || \"none\"), kind: 1, startTimeUnixNano: start, endTimeUnixNano: end, attributes: [str(\"langfuse.observation.type\", \"span\"), str(\"langfuse.observation.input\", JSON.stringify({ proposal_id: r.proposal_id, summary: r.summary })), str(\"langfuse.observation.metadata.reason\", r.reason || \"\")], status: { code: 1 } })); return JSON.stringify({ resourceSpans: [{ resource: { attributes: [str(\"service.name\", \"n8n-follow-up-agent\")] }, scopeSpans: [{ scope: { name: \"n8n\" }, spans }] }] }); })() }}",
        "options": {}
      },
